# Copiá este archivo como `.env` en el servidor y completá los valores.
# El backend lee estas variables (o usa los valores por defecto locales).

# Puerto del servidor (en producción sirve API + frontend juntos)
PORT=4000

# PostgreSQL (la app crea las tablas y datos iniciales sola al arrancar)
PGHOST=localhost
PGPORT=5432
PGDATABASE=iptv
PGUSER=iptv
PGPASSWORD=cambiame
# Alternativa: DATABASE_URL=postgres://usuario:clave@host:5432/basedatos

# Claves de las cuentas internas. En producción PONÉ claves fuertes:
# si están definidas, se aplican en cada arranque (podés cambiarlas acá).
ADMIN_PASSWORD=cambiame
RESELLER_PASSWORD=cambiame

# Cada registro público recibe una prueba personal fija de 24 horas.
# STREAM_SECRET: clave privada larga para enlaces de Smart TV con vencimiento.
# Si se omite se genera en memoria; reiniciar invalida los enlaces existentes.
STREAM_SECRET=

# ---------- Catálogo de películas/series (TheTVDB V4) ----------
# API Key y PIN de suscriptor del nivel gratuito de TheTVDB (https://thetvdb.com).
# Sin estos valores el catálogo funciona con lo que haya en la base (incluido el
# contenido de dominio público), pero NO importa títulos nuevos de TheTVDB.
THETVDB_API_KEY=
THETVDB_PIN=
# Sincronización incremental automática (/updates). false para desactivarla.
CATALOG_SYNC=true
# Cada cuántos minutos corre la sync incremental (default 360 = 6 h).
CATALOG_SYNC_MINUTES=360

# TMDB (The Movie Database): metadatos de películas ACTUALES/populares para que
# la portada se vea representable. API Key gratuita en https://www.themoviedb.org
# (Ajustes -> API). Solo metadatos; la reproducción necesita fuente licenciada.
TMDB_API_KEY=
