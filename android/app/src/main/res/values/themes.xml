<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat para que el botón de Cast (MediaRouteButton) funcione. -->
    <style name="Theme.LiveTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Ícono de Chromecast (MediaRouteButton) siempre blanco y visible. -->
        <item name="mediaRouteButtonTint">@android:color/white</item>
    </style>
</resources>
