{
  "name": "iptv-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma IPTV: catálogo + reproductor alimentado por iptv-org",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace web",
    "import:vod": "node server/scripts/import-vod.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
