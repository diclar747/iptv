{
  "name": "iptv-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma IPTV: catálogo + reproductor alimentado por iptv-org",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace web",
    "import:vod": "node server/scripts/import-vod.mjs",
    "import:radios": "node server/scripts/import-radios.mjs && node server/scripts/import-desdeparaguay.mjs && node server/scripts/verify-radios.mjs",
    "import:radios:desdeparaguay": "node server/scripts/import-desdeparaguay.mjs && node server/scripts/verify-radios.mjs",
    "setup:youtube": "node server/scripts/setup-youtube.mjs",
    "package:companion": "node server/scripts/package-companion.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
